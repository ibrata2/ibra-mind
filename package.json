{
  "name": "ibra-mind",
  "private": true,
  "description": "IBRA MIND – AI Mind Mapping & Visual Thinking Studio",
  "author": "Ibrahim Al-Khazraji",
  "copyright": "Copyright © 2026 Ibrahim Al-Khazraji. All Rights Reserved.",
  "version": "0.4.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "test:smoke": "node tests/provider-smoke.cjs",
    "preview": "vite preview --configLoader runner",
    "desktop:dev": "concurrently -k \"vite --configLoader runner --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.8.5",
    "framer-motion": "^12.23.12",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "read-excel-file": "^9.3.14",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.ibraprogram.ibramind",
    "productName": "IBRA MIND",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "IBRA MIND account link",
        "schemes": ["ibramind"]
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IBRA MIND"
    }
  }
}
