{
  "name": "ibra-mind",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": { "@xyflow/react": "^12.8.5", "framer-motion": "^12.23.12", "lucide-react": "^0.468.0", "react": "^19.1.1", "react-dom": "^19.1.1", "zustand": "^5.0.8" },
  "devDependencies": { "@tailwindcss/vite": "^4.1.14", "@types/react": "^19.1.16", "@types/react-dom": "^19.1.9", "@vitejs/plugin-react": "^5.0.4", "concurrently": "^9.2.1", "electron": "^39.2.7", "electron-builder": "^26.0.12", "tailwindcss": "^4.1.14", "typescript": "~5.9.3", "vite": "^7.1.10", "wait-on": "^8.0.3" },
  "build": {
    "appId": "com.ibraprogram.ibramind",
    "productName": "IBRA MIND",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IBRA MIND"
    }
  }
}
